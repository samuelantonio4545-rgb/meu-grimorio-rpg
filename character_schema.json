{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DND5eCharacterSheet",
  "type": "object",
  "required": [
    "meta",
    "attributes",
    "hp",
    "skills",
    "savingThrows",
    "inventory",
    "spells",
    "conditions",
    "restState",
    "concentration"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["name", "level", "experience", "class", "race", "background"],
      "properties": {
        "name": { "type": "string" },
        "level": { "type": "integer", "minimum": 1, "maximum": 20 },
        "experience": { "type": "integer", "minimum": 0 },
        "class": { "type": "string" },
        "subclass": { "type": "string" },
        "race": { "type": "string" },
        "subrace": { "type": "string" },
        "background": { "type": "string" },
        "alignment": { "type": "string" },
        "portraitUrl": { "type": "string", "format": "uri" }
      }
    },
    "attributes": {
      "type": "object",
      "required": ["strength", "dexterity", "constitution", "intelligence", "wisdom", "charisma", "tashaCustomization"],
      "properties": {
        "strength": { "type": "integer", "minimum": 1, "maximum": 30 },
        "dexterity": { "type": "integer", "minimum": 1, "maximum": 30 },
        "constitution": { "type": "integer", "minimum": 1, "maximum": 30 },
        "intelligence": { "type": "integer", "minimum": 1, "maximum": 30 },
        "wisdom": { "type": "integer", "minimum": 1, "maximum": 30 },
        "charisma": { "type": "integer", "minimum": 1, "maximum": 30 },
        "tashaCustomization": {
          "type": "object",
          "required": ["enabled", "abilityScoreSwaps", "customLanguages", "customProficiencies"],
          "properties": {
            "enabled": { "type": "boolean" },
            "abilityScoreSwaps": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["from", "to", "value"],
                "properties": {
                  "from": { "type": "string", "enum": ["str", "dex", "con", "int", "wis", "cha"] },
                  "to": { "type": "string", "enum": ["str", "dex", "con", "int", "wis", "cha"] },
                  "value": { "type": "integer", "enum": [1, 2] }
                }
              }
            },
            "customLanguages": {
              "type": "array",
              "items": { "type": "string" }
            },
            "customProficiencies": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        }
      }
    },
    "hp": {
      "type": "object",
      "required": ["max", "current", "temporary", "deathSaves"],
      "properties": {
        "max": { "type": "integer", "minimum": 1 },
        "current": { "type": "integer", "minimum": 0 },
        "temporary": { "type": "integer", "minimum": 0 },
        "deathSaves": {
          "type": "object",
          "required": ["successes", "failures"],
          "properties": {
            "successes": { "type": "integer", "minimum": 0, "maximum": 3 },
            "failures": { "type": "integer", "minimum": 0, "maximum": 3 }
          }
        }
      }
    },
    "skills": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["proficient", "expertise", "customModifier"],
        "properties": {
          "proficient": { "type": "boolean" },
          "expertise": { "type": "boolean" },
          "customModifier": { "type": "integer" }
        }
      }
    },
    "savingThrows": {
      "type": "object",
      "required": ["str", "dex", "con", "int", "wis", "cha"],
      "properties": {
        "str": { "$ref": "#/definitions/savingThrowState" },
        "dex": { "$ref": "#/definitions/savingThrowState" },
        "con": { "$ref": "#/definitions/savingThrowState" },
        "int": { "$ref": "#/definitions/savingThrowState" },
        "wis": { "$ref": "#/definitions/savingThrowState" },
        "cha": { "$ref": "#/definitions/savingThrowState" }
      }
    },
    "inventory": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "quantity", "weight", "isEquipped", "description"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "quantity": { "type": "integer", "minimum": 0 },
          "weight": { "type": "number", "minimum": 0 },
          "isEquipped": { "type": "boolean" },
          "imageUrl": { "type": "string" },
          "description": { "type": "string" },
          "isAmmunition": { "type": "boolean" },
          "ammunitionType": { "type": "string" },
          "consumesAmmunitionId": { "type": "string" },
          "cost": { "type": "string" },
          "properties": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "spells": {
      "type": "object",
      "required": ["spellcastingAbility", "spellSaveDC", "spellAttackBonus", "slots", "list"],
      "properties": {
        "spellcastingAbility": { "type": "string", "enum": ["int", "wis", "cha", "none"] },
        "spellSaveDC": { "type": "integer" },
        "spellAttackBonus": { "type": "integer" },
        "slots": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["max", "current"],
            "properties": {
              "max": { "type": "integer", "minimum": 0 },
              "current": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "list": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name", "level", "school", "castingTime", "range", "components", "duration", "concentration", "description"],
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "level": { "type": "integer", "minimum": 0, "maximum": 9 },
              "school": { "type": "string" },
              "castingTime": { "type": "string" },
              "range": { "type": "string" },
              "components": { "type": "string" },
              "duration": { "type": "string" },
              "concentration": { "type": "boolean" },
              "description": { "type": "string" },
              "prepared": { "type": "boolean" }
            }
          }
        }
      }
    },
    "conditions": {
      "type": "object",
      "required": [
        "blinded", "charmed", "deafened", "frightened", "grappled",
        "incapacitated", "invisible", "paralyzed", "petrified", "poisoned",
        "prone", "restrained", "stunned", "unconscious", "exhaustion"
      ],
      "properties": {
        "blinded": { "type": "boolean" },
        "charmed": { "type": "boolean" },
        "deafened": { "type": "boolean" },
        "frightened": { "type": "boolean" },
        "grappled": { "type": "boolean" },
        "incapacitated": { "type": "boolean" },
        "invisible": { "type": "boolean" },
        "paralyzed": { "type": "boolean" },
        "petrified": { "type": "boolean" },
        "poisoned": { "type": "boolean" },
        "prone": { "type": "boolean" },
        "restrained": { "type": "boolean" },
        "stunned": { "type": "boolean" },
        "unconscious": { "type": "boolean" },
        "exhaustion": { "type": "integer", "minimum": 0, "maximum": 6 }
      }
    },
    "restState": {
      "type": "object",
      "required": ["hitDiceTotal", "hitDiceRemaining", "customResources"],
      "properties": {
        "hitDiceTotal": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "hitDiceRemaining": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "customResources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "maxUses", "currentUses", "rechargeOn"],
            "properties": {
              "name": { "type": "string" },
              "maxUses": { "type": "integer", "minimum": 1 },
              "currentUses": { "type": "integer", "minimum": 0 },
              "rechargeOn": { "type": "string", "enum": ["shortRest", "longRest", "other"] }
            }
          }
        }
      }
    },
    "concentration": {
      "type": "object",
      "required": ["isConcentrating", "spellId", "spellName"],
      "properties": {
        "isConcentrating": { "type": "boolean" },
        "spellId": { "type": ["string", "null"] },
        "spellName": { "type": ["string", "null"] }
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "definitions": {
    "savingThrowState": {
      "type": "object",
      "required": ["proficient", "customModifier"],
      "properties": {
        "proficient": { "type": "boolean" },
        "customModifier": { "type": "integer" }
      }
    }
  }
}
